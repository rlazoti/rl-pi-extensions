{
	"name": "rl-pi-extensions",
	"version": "1.12.0",
	"description": "Personal Pi coding agent extensions — memory, todos, ask, snippets, context viewer, session banner, session attention, tmux and emacs feedback, turn, scan and settle guards",
	"type": "module",
	"license": "MIT",
	"author": "Rodrigo Lazoti",
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*"
	},
	"pi": {
		"extensions": [
			"./extensions/rl-extensions/index.ts"
		]
	},
	"dependencies": {
		"minisearch": "^7.2.0",
		"typebox": "1.3.27"
	},
	"scripts": {
		"postinstall": "node scripts/gen-ts-paths.mjs --allow-missing",
		"gen:ts-paths": "node scripts/gen-ts-paths.mjs",
		"pretest": "node scripts/gen-ts-paths.mjs",
		"pretypecheck": "node scripts/gen-ts-paths.mjs",
		"setup:memory": "npm ci --prefix extensions/memory",
		"test": "npm run test:extensions && npm run test:memory",
		"test:extensions": "node --experimental-strip-types --import ./test-support/register.mjs --test $(find tests extensions -path extensions/memory -prune -o \\( -name '*.test.ts' -o -name '*.test.mjs' \\) -print)",
		"test:memory": "node scripts/require-memory-deps.mjs && npm --prefix extensions/memory test",
		"typecheck": "tsc -p tsconfig.json && node scripts/require-memory-deps.mjs && npm --prefix extensions/memory run typecheck",
		"verify:memory": "npm --prefix extensions/memory run verify"
	},
	"devDependencies": {
		"@types/node": "26.6.5",
		"typescript": "7.0.2"
	},
	"peerDependenciesMeta": {
		"@earendil-works/pi-ai": {
			"optional": true
		},
		"@earendil-works/pi-coding-agent": {
			"optional": true
		},
		"@earendil-works/pi-tui": {
			"optional": true
		}
	}
}
