{
	"name": "rl-pi-extensions",
	"version": "1.9.0",
	"description": "Personal Pi coding agent extensions — tmux feedback, session banner, session attention, snippets, emacs feedback, turn and scan guards",
	"type": "module",
	"license": "MIT",
	"author": "Rodrigo Lazoti",
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*"
	},
	"pi": {
		"extensions": [
			"./extensions/rl-extensions/index.ts"
		]
	},
	"scripts": {
		"postinstall": "npm ci --prefix extensions/memory",
		"test": "npm run test:extensions && npm run test:memory",
		"test:extensions": "node --experimental-strip-types --import ./test-support/register.mjs --test $(find tests extensions -path extensions/memory -prune -o \\( -name '*.test.ts' -o -name '*.test.mjs' \\) -print)",
		"test:memory": "npm --prefix extensions/memory test",
		"typecheck": "tsc -p tsconfig.json && npm --prefix extensions/memory run typecheck",
		"verify:memory": "npm --prefix extensions/memory run verify"
	},
	"devDependencies": {
		"@earendil-works/pi-ai": "1.5.0",
		"@earendil-works/pi-coding-agent": "1.5.0",
		"@earendil-works/pi-tui": "1.5.0",
		"typescript": "7.0.2"
	}
}
