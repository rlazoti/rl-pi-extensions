{
	// Type-check gate only: Pi loads extensions through jiti, which strips types
	// without checking them, so `npm test` alone never sees a type error. Run
	// `npm run typecheck` (needs `npm install`, which generates .pi/tsconfig.pi-types.json).
	// Nothing is emitted.
	//
	// The extends is generated, machine-local, and points at the installed Pi:
	// @earendil-works/* is deliberately NOT a dependency, because a pin there is
	// resolved by pnpm even under --prod and an internal registry mirror that
	// lags one Pi release then blocks installing the package outright. See
	// scripts/gen-ts-paths.mjs.
	"extends": "./.pi/tsconfig.pi-types.json",
	"compilerOptions": {
		"target": "es2023",
		"lib": ["es2023"],
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"types": ["node"],
		"strict": true,
		"noEmit": true,
		// Tests import sibling sources with an explicit .ts specifier (bare-node
		// type stripping requires it); extension sources use jiti-style .js.
		"allowImportingTsExtensions": true,
		"skipLibCheck": true
	},
	"include": ["extensions/**/*.ts", "tests/**/*.ts"],
	"exclude": ["extensions/memory"]
}
